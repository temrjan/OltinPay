# OltinPay — environment variables template
#
# Copy to `.env` on the server: `cp .env.example .env && chmod 600 .env`
# Consumed by `docker compose` (project `oltinpay-app`): `env_file` for
# oltinpay-api, and `${TELEGRAM_BOT_TOKEN}` interpolation for the bot profile.
# Rebuilt 2026-07-26 from src/config.py (the sole env-reading surface — the API
# reads nothing outside pydantic Settings; extra="ignore" drops unknown keys).
# Contract addresses are canonical per docs/DEPLOYMENTS.md. Do NOT commit a
# populated `.env`.
# ----------------------------------------------------------------------

# JWT signing key (required; keep the live value to preserve existing tokens)
SECRET_KEY=

# Telegram Bot API token (optional; needed only when the bot profile is up)
TELEGRAM_BOT_TOKEN=

# Shared infra (project `infra` on the `internal` network) — do NOT point
# at compose-local services, they no longer exist in this stack.
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@postgres:5432/oltinpay_db
REDIS_URL=redis://:CHANGE_ME@redis:6379/3

# CORS (comma-separated, no spaces)
CORS_ORIGINS_STR=https://app.oltinpay.com,http://localhost:3000

# Aylin AI assistant (znai-cloud; leave both empty to disable the assistant)
ZNAI_CLOUD_URL=
ZNAI_CLOUD_API_KEY=

# Blockchain — zkSync Era Sepolia (chainId 300), V3.1 contracts.
# All seven addresses pinned explicitly; canonical values from docs/DEPLOYMENTS.md.
ZKSYNC_RPC_URL=https://sepolia.era.zksync.dev
ZKSYNC_CHAIN_ID=300
OLTIN_CONTRACT_ADDRESS=0x906bcf6c92ed1b30aA453c69eB40aeDbb3d5B3A5
UZD_CONTRACT_ADDRESS=0x51232fd0065bD2ca50551761Acef476E3CDf02aA
STAKING_CONTRACT_ADDRESS=0xD3b6ffd1dE409e1C37BA5B867d6eC3897A721fAa
EXCHANGE_ADDRESS=0x99D733E64eb60c3B3D5f3DeDe4CC4adC92BCd1c9
RESERVE_ATTESTOR_ADDRESS=0x9413F60295dcf7D81fcb69eE256029900B107d1B
XAU_FEED_ADDRESS=0xe0AFc7eD0c6028b8172C2b108624168d235e8BFD
UZS_FEED_ADDRESS=0x637347fd661cFFAE9B562aFA394A392214fa24aD

# Legacy single admin key — currently EMPTY (decision К-6). PR-2 server-side
# writes go through the role keys below, not this key.
ADMIN_PRIVATE_KEY=

# SignerPool role keys (each a distinct EOA — ONE writer per key; keep empty
# unless actively signing). Demo/testnet keys only; production uses KMS/HSM.
#   KEY_BANK_OPS — UZD mint/burn (bank deposits, withdrawal confirms, welcome)
#   KEY_RESERVE  — ReserveAttestor.postAnswer (/bank/attestations)
#   KEY_UZS      — UzsUsdFeed.postAnswer (/bank/fx; keeper-uzs is retired)
#   KEY_XAU      — external keeper-xau ONLY (the API never signs XAU)
KEY_BANK_OPS=
KEY_RESERVE=
KEY_UZS=
KEY_XAU=

# Welcome gas drip — one-off native ETH top-up so a brand-new wallet (0 OLTIN)
# can pay for its first plain-tx. Sent from KEY_BANK_OPS on the welcome claim,
# but ONLY when the wallet's live balance is below DRIP_ETH_THRESHOLD_WEI (the
# chain balance is the idempotency gate — a retry never double-drips).
DRIP_ETH_WEI=1000000000000000
DRIP_ETH_THRESHOLD_WEI=500000000000000

# Bank connector HMAC auth (shared secret with the bank client)
#   X-Bank-Signature = HMAC-SHA256(BANK_HMAC_SECRET, body + X-Bank-Timestamp + X-Bank-Nonce)
BANK_HMAC_SECRET=
BANK_HMAC_MAX_SKEW_SEC=300

# Chain indexer (simple last-N poller; not reorg-safe — testnet demo only).
# Pinned explicitly: it starts a background poller on boot; it must not be a
# silent moving part at cutover.
INDEXER_ENABLED=true
INDEXER_POLL_SEC=15
INDEXER_LOOKBACK_BLOCKS=5000
