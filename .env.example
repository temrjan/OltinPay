# OltinPay — environment variables template
#
# Copy to `.env` on the server: `cp .env.example .env && chmod 600 .env`
# All variables below must be set before `docker compose up`.
# Key set verified 2026-07-25 against the LIVE oltinpay-api container
# (names only, values never printed). Do NOT commit a populated `.env`.
# ----------------------------------------------------------------------

# JWT signing key (keep the live value to preserve existing tokens)
SECRET_KEY=

# Telegram Bot API token
TELEGRAM_BOT_TOKEN=

# Shared infra (project `infra` on the `internal` network) — do NOT point
# at compose-local services, they no longer exist in this stack.
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@postgres:5432/oltinpay_db
REDIS_URL=redis://:CHANGE_ME@redis:6379/3

# CORS (comma-separated, no spaces)
CORS_ORIGINS_STR=https://app.oltinpay.com,http://localhost:3000

# Aylin AI assistant (via RAG service; leave empty to disable)
RAG_SERVICE_URL=
RAG_SERVICE_API_KEY=

# Blockchain — zkSync Era Sepolia (V3.1, see docs/DEPLOYMENTS.md)
UZD_CONTRACT_ADDRESS=0x51232fd0065bD2ca50551761Acef476E3CDf02aA
EXCHANGE_ADDRESS=0x99D733E64eb60c3B3D5f3DeDe4CC4adC92BCd1c9

# Legacy single admin key — currently EMPTY (decision К-6 pending, R-1).
# PR-2 server-side writes go through role keys once configured.
ADMIN_PRIVATE_KEY=
